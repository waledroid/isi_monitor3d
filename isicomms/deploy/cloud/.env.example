# Copy to .env and fill before running docker compose up.
# NEVER commit .env — it is gitignored.

# Mosquitto broker credentials (set with mosquitto_passwd; same value on each Backbone node)
MQTT_USERNAME=
MQTT_PASSWORD=

# ISI-gateway API bearer token (AGVs / WMS include this in Authorization: Bearer <token>)
API_TOKEN=

# Hostname or IP used in the TLS certificate SAN (must match what clients connect to).
# Run gen-certs.sh after setting this.
CERT_HOST=
