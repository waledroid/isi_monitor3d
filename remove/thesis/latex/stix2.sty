% Local replacement for stix2.sty (loaded by rho.cls as the body typeface).
% The tectonic bundle's Type-1 stix2 math setup is incomplete (fallback fonts
% silently drop \times, minus, primes and \mid) and its symbol macros clash
% with unicode-math. This stub keeps the SAME intended typeface --- STIX Two
% --- but through the bundled OpenType fonts: text here via fontspec, math via
% unicode-math + STIXTwoMath-Regular.otf in the document preamble.
% Delete this file to restore the CTAN stix2 package under full TeX Live.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{stix2}[2026/07/21 local OpenType STIX Two setup (tectonic bundle workaround)]
\DeclareOption*{}% swallow [notextcomp] and friends
\ProcessOptions\relax
\RequirePackage{fontspec}
\setmainfont{STIXTwoText}[
  Extension      = .otf,
  UprightFont    = *-Regular,
  BoldFont       = *-Bold,
  ItalicFont     = *-Italic,
  BoldItalicFont = *-BoldItalic,
  Ligatures      = TeX,
]
\endinput
